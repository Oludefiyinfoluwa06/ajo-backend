// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SAVER
  MEMBER
  COORDINATOR
  ADMIN
}

enum KycStatus {
  PENDING
  VERIFIED
  FAILED
}

enum TransactionType {
  FUNDING
  WITHDRAWAL
  CONTRIBUTION
  PAYOUT
  SAVINGS_DEPOSIT
  LATE_FEE
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WalletStatus {
  ACTIVE
  LOCKED
  SUSPENDED
}

enum SavingsGoalStatus {
  ACTIVE
  MATURED
  DELETED
}

enum GroupStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum GroupFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum GroupMemberStatus {
  ACTIVE
  REMOVED
}

enum ContributionStatus {
  PAID
  UNPAID
  LATE
}

enum PayoutStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PayoutOrderMethod {
  MANUAL
  FIRST_JOINED
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  passwordHash     String
  fullName         String
  displayName      String?
  profilePhotoUrl  String?
  phoneNumber      String?
  phoneVerified    Boolean     @default(false)
  bvnEncrypted     String?
  role             Role[]      @default([SAVER])
  kycStatus        KycStatus   @default(PENDING)
  isActive         Boolean     @default(false)
  isSuspended      Boolean     @default(false)
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  wallet           Wallet?
  bankAccounts     BankAccount[]
  savingsGoals     SavingsGoal[]
  groupsCoordinated AjoGroup[]  @relation("CoordinatorGroups")
  groupMemberships GroupMember[]
  payoutsReceived  Payout[]     @relation("PayoutRecipient")
  payoutsTriggered Payout[]     @relation("PayoutTriggeredBy")
  auditLogs        AuditLog[]
  transactionPin   TransactionPin?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model TransactionPin {
  id             String    @id @default(cuid())
  userId         String    @unique
  pinHash        String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transaction_pins")
}

model Wallet {
  id                   String        @id @default(cuid())
  userId               String        @unique
  balance              Decimal       @default(0) @db.Decimal(12, 2)
  virtualAccountNumber String        @unique
  bankName             String
  bankCode             String
  monnifyAccountRef    String?       @unique
  status               WalletStatus  @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  savingsGoals         SavingsGoal[]

  @@map("wallets")
}

model BankAccount {
  id                     String   @id @default(cuid())
  userId                 String
  accountNumberEncrypted String
  bankCode               String
  bankName               String
  accountName            String
  isDefault              Boolean  @default(false)
  createdAt              DateTime @default(now())

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

model Transaction {
  id           String            @id @default(cuid())
  walletId     String
  type         TransactionType
  amount       Decimal           @db.Decimal(12, 2)
  fee          Decimal           @default(0) @db.Decimal(12, 2)
  status       TransactionStatus @default(PENDING)
  reference    String            @unique
  monnifyRef   String?
  description  String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  wallet       Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  contribution Contribution?
  payout       Payout?

  @@map("transactions")
}

model SavingsGoal {
  id            String            @id @default(cuid())
  walletId      String
  userId        String
  name          String
  targetAmount  Decimal           @db.Decimal(12, 2)
  currentAmount Decimal           @default(0) @db.Decimal(12, 2)
  targetDate    DateTime
  status        SavingsGoalStatus @default(ACTIVE)
  maturedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  wallet        Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("savings_goals")
}

model AjoGroup {
  id                   String           @id @default(cuid())
  coordinatorId        String
  name                 String
  contributionAmount   Decimal          @db.Decimal(12, 2)
  frequency            GroupFrequency
  maxMembers           Int
  payoutOrderMethod    PayoutOrderMethod @default(FIRST_JOINED)
  status               GroupStatus      @default(DRAFT)
  currentRound         Int              @default(0)
  inviteToken          String           @unique @default(cuid())
  inviteActive         Boolean          @default(true)
  virtualAccountNumber String?          @unique
  bankName             String?
  bankCode             String?
  monnifyAccountRef    String?          @unique
  lateFeeEnabled       Boolean          @default(false)
  lateFeeAmount        Decimal?         @db.Decimal(12, 2)
  cycleStartDate       DateTime?
  nextDueDate          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  coordinator          User             @relation("CoordinatorGroups", fields: [coordinatorId], references: [id], onDelete: Restrict)
  members              GroupMember[]
  contributions        Contribution[]
  payouts              Payout[]

  @@map("ajo_groups")
}

model GroupMember {
  id             String            @id @default(cuid())
  groupId        String
  userId         String
  payoutPosition Int
  status         GroupMemberStatus @default(ACTIVE)
  joinedAt       DateTime          @default(now())
  removedAt      DateTime?

  group          AjoGroup          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  contributions  Contribution[]

  @@unique([groupId, userId])
  @@unique([groupId, payoutPosition])
  @@map("group_members")
}

model Contribution {
  id            String             @id @default(cuid())
  groupId       String
  memberId      String
  round         Int
  amount        Decimal            @db.Decimal(12, 2)
  status        ContributionStatus @default(UNPAID)
  paidAt        DateTime?
  transactionId String?            @unique
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  group         AjoGroup           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  member        GroupMember        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  transaction   Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([groupId, memberId, round])
  @@map("contributions")
}

model Payout {
  id            String       @id @default(cuid())
  groupId       String
  recipientId   String
  triggeredById String
  round         Int
  amount        Decimal      @db.Decimal(12, 2)
  status        PayoutStatus @default(PENDING)
  transactionId String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  group         AjoGroup     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  recipient     User         @relation("PayoutRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  triggeredBy   User         @relation("PayoutTriggeredBy", fields: [triggeredById], references: [id], onDelete: Restrict)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([groupId, round])
  @@map("payouts")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorRole   Role?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
